{#
/**
 * @file
 * Call to action below an article imported from Substack.
 *
 * Imported articles carry an excerpt rather than the whole post, so this points
 * readers at the original and invites them to subscribe. Edit the wording here;
 * it is not stored in the nodes, so changes apply to every Substack article
 * immediately and need no re-import.
 *
 * Available variables:
 * - post_url: Absolute URL of the post on Substack. May be empty.
 * - subscribe_url: Absolute URL of the publication's subscribe page.
 */
#}
<aside class="substack-cta">
  {% if post_url %}
    <p class="substack-cta__continue">
      <a href="{{ post_url }}" rel="noopener">Continue reading this post on Substack</a>
    </p>
  {% endif %}
  <p class="substack-cta__subscribe">
    Maria writes <em>Off Script</em> and her reporting notes on Substack.
    <a href="{{ subscribe_url }}" rel="noopener">Subscribe for new posts by email</a>.
  </p>
</aside>
