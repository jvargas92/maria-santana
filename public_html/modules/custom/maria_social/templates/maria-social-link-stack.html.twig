{#
/**
 * @file
 * The social platforms as a stack of rows, for a link-in-bio page.
 *
 * Available variables:
 * - rows: one entry per enabled link in the "social" menu that has an
 *   address, each with:
 *   - title: the platform's name.
 *   - url: the address, already built.
 *   - icon: a render array for the brand mark, or null.
 *   - description: the link's description, used as a blurb, or an empty string.
 *   - description_id: an id for that blurb, or null when there is none.
 *
 * Only the icon and the name are inside the link. The blurb sits outside it,
 * tied back with aria-describedby, so the link's accessible name stays the
 * platform rather than becoming a whole sentence.
 */
#}
{% if rows is not empty %}
  <ul class="link-stack">
    {% for row in rows %}
      <li class="link-stack__item">
        <a
          class="link-stack__link"
          href="{{ row.url }}"
          target="_blank"
          rel="noopener noreferrer"
          {% if row.description_id %}aria-describedby="{{ row.description_id }}"{% endif %}
        >
          {% if row.icon %}
            <span class="link-stack__icon" aria-hidden="true">{{ row.icon }}</span>
          {% endif %}
          <span class="link-stack__label">{{ row.title }}</span>
          <span class="link-stack__chevron" aria-hidden="true">&rarr;</span>
          <span class="visually-hidden">{{ '(opens in a new tab)'|t }}</span>
        </a>

        {% if row.description is not empty %}
          <p class="link-stack__description" id="{{ row.description_id }}">
            {{ row.description }}
          </p>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}
