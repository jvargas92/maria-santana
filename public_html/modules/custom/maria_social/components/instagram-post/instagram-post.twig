{#
/**
 * @file
 * One embedded Instagram post, reel or video.
 *
 * A vertical reel cannot be shown at 9:16 through this component, and that is
 * Instagram's doing, not ours. Its embed hardcodes the media container to
 * `padding-bottom: 125%`, a 4:5 crop, inside a cross-origin iframe that no CSS
 * of ours can reach. The embed also ships a cover image rather than a video
 * element, so it is a picture that links to Instagram, not a player. For a
 * reel shown full height and actually playable, host the video on the site or
 * on YouTube instead of embedding it from here.
 *
 * What the shape does control is the width of the column. Instagram's script
 * sizes its iframe from the width available, so the "tall" shape narrows the
 * card, which makes the 4:5 crop read as portrait instead of as a wide block,
 * and keeps the card from running extremely tall on a desktop screen. It also
 * uses the /reel/ form of the permalink, which is the address Instagram
 * documents for video.
 */
#}
{{ attach_library('maria_social/social_embed') }}
{{ attach_library('maria_social/instagram_embed') }}

{% set shape = orientation|default('auto') %}
{% if shape == 'auto' %}
  {# A reel or video link gets the narrow column by default. #}
  {% set shape = ('/reel/' in url or '/tv/' in url) ? 'tall' : 'wide' %}
{% endif %}

{% set permalink = shape == 'tall' ? url|replace({'/p/': '/reel/'}) : url %}

<div class="social-embed social-embed--instagram{{ shape == 'tall' ? ' social-embed--portrait' : '' }}">
  <blockquote
    class="instagram-media"
    data-instgrm-permalink="{{ permalink }}"
    data-instgrm-version="14"
  >
    <a href="{{ permalink }}" rel="noopener" target="_blank">{{ 'View this post on Instagram'|t }}</a>
  </blockquote>
</div>
