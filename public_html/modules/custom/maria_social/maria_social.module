<?php

/**
 * @file
 * Hooks for the Maria Santana social embeds module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;

/**
 * Where the Substack call to action sends people to subscribe.
 *
 * The publication is the same on every environment, so this is a constant
 * rather than configuration.
 */
const MARIA_SOCIAL_SUBSTACK_SUBSCRIBE_URL = 'https://mariasantanamedia.substack.com/subscribe';

/**
 * Implements hook_theme_registry_alter().
 *
 * FormaTheme's social menu labels each icon link "Follow us on " with the
 * platform name missing (icon-only menu links have an empty title), and that
 * aria-label hides the icon's own label. Use a corrected copy of the template
 * instead, without modifying the contributed theme.
 */
function maria_social_theme_registry_alter(array &$theme_registry): void {
  if (isset($theme_registry['menu__social'])) {
    $theme_registry['menu__social']['path'] = \Drupal::service('extension.list.module')->getPath('maria_social') . '/templates';
    $theme_registry['menu__social']['template'] = 'menu--social';
  }
}

/**
 * Implements hook_modules_installed().
 *
 * A Feeds feed is a content entity, so configuration import creates the
 * "substack" feed type but never the feed itself. Hooking module installation
 * catches the moment Feeds is enabled, which on a fresh environment happens
 * during the configuration import, and leaves the feed ready without a manual
 * step. It deliberately still runs while configuration is syncing: sync owns
 * configuration, and this is content.
 */
function maria_social_modules_installed(array $modules, bool $is_syncing): void {
  if (in_array('feeds', $modules, TRUE)) {
    maria_social_ensure_substack_feed();
  }
}

/**
 * Makes sure the Substack feed exists, and returns it.
 *
 * Safe to call repeatedly: it returns the existing feed untouched rather than
 * adding a second one, so it can be driven from module installation, from a
 * post-update hook, or by hand on an environment that already has Feeds.
 *
 * @return \Drupal\feeds\FeedInterface|null
 *   The feed, or NULL if Feeds is not enabled or the feed type is missing.
 */
function maria_social_ensure_substack_feed(): ?object {
  // Her publication's RSS feed. Public, and the same on every environment.
  $source = 'https://mariasantanamedia.substack.com/feed';

  if (!\Drupal::moduleHandler()->moduleExists('feeds')) {
    return NULL;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('feeds_feed');
  if (!\Drupal::entityTypeManager()->getStorage('feeds_feed_type')->load('substack')) {
    return NULL;
  }

  $existing = $storage->loadByProperties(['type' => 'substack']);
  if ($existing !== []) {
    return reset($existing);
  }

  $feed = $storage->create([
    'type' => 'substack',
    'title' => 'Maria Santana on Substack',
    'source' => $source,
    'uid' => 1,
    'status' => 1,
  ]);
  $feed->save();

  return $feed;
}

/**
 * Forces every item in the Substack feed to be processed again.
 *
 * A plain feeds:import will not revisit an item it has already seen: the HTTP
 * fetcher sends If-Modified-Since and takes the 304, and the processor skips
 * items whose hash is unchanged. So after a mapping changes, existing nodes
 * keep their old values and the import reports "no new items", which looks
 * like the mapping did not work. This clears the download cache and lifts the
 * hash check for one run, so the feed updates the nodes in place, keeping
 * their IDs and aliases.
 *
 * @return string
 *   A short report, suitable for printing from drush.
 */
function maria_social_reimport_substack(): string {
  if (!\Drupal::moduleHandler()->moduleExists('feeds')) {
    return 'Feeds is not enabled.';
  }
  $feed_type = \Drupal::entityTypeManager()->getStorage('feeds_feed_type')->load('substack');
  if (!$feed_type) {
    return 'The "substack" feed type is missing. Import configuration first.';
  }

  // Report what the feed type will actually do, so a missing mapping shows up
  // here rather than looking like a failed import.
  $targets = array_column($feed_type->getMappings(), 'target');
  if (!in_array('field_content', $targets, TRUE)) {
    return 'The feed type has no field_content mapping, so bodies cannot be '
      . 'imported. Run config:import first. Current targets: '
      . implode(', ', $targets);
  }

  $feed = maria_social_ensure_substack_feed();
  if (!$feed) {
    return 'No Substack feed to import.';
  }

  $config = $feed_type->getProcessor()->getConfiguration();
  $restore = $config['skip_hash_check'];
  $config['skip_hash_check'] = TRUE;
  $feed_type->set('processor_configuration', $config)->save();
  \Drupal::service('cache.feeds_download')->deleteAll();

  try {
    $feed->import();
  }
  finally {
    // Always put the hash check back, even if the import threw.
    $config['skip_hash_check'] = $restore;
    $feed_type->set('processor_configuration', $config)->save();
  }

  return 'Re-imported ' . $feed->getSource() . '. Check the feed\'s report for how many items were updated.';
}

/**
 * Implements hook_theme().
 */
function maria_social_theme(): array {
  return [
    'maria_social_link_stack' => [
      'variables' => ['rows' => []],
    ],
    'maria_social_substack_cta' => [
      'variables' => ['post_url' => NULL, 'subscribe_url' => NULL],
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_view() for nodes.
 *
 * Articles imported from Substack carry only the first few paragraphs of the
 * post: the feed's full content is truncated on the way in, so the site is not
 * republishing each piece in its entirety alongside Substack. That makes a
 * pointer to the original necessary, and an invitation to subscribe useful.
 *
 * The call to action is rendered here rather than appended to the imported body
 * so that its wording lives in one template instead of inside every node, can
 * be changed without re-importing the feed, and is not restricted to the tags
 * the "Imported post content" text format allows.
 *
 * @see maria_social_reimport_substack()
 */
function maria_social_node_view(array &$build, EntityInterface $node, EntityViewDisplayInterface $display, string $view_mode): void {
  if ($view_mode !== 'full' || $node->bundle() !== 'article') {
    return;
  }
  if (!$node->hasField('field_source') || $node->get('field_source')->value !== 'substack') {
    return;
  }

  $post_url = '';
  if ($node->hasField('field_source_url') && !$node->get('field_source_url')->isEmpty()) {
    $post_url = $node->get('field_source_url')->first()->getUrl()->toString();
  }

  // Sits between the body (weight 100) and the author credit (weight 102).
  $build['maria_social_substack_cta'] = [
    '#theme' => 'maria_social_substack_cta',
    '#post_url' => $post_url,
    '#subscribe_url' => MARIA_SOCIAL_SUBSTACK_SUBSCRIBE_URL,
    '#weight' => 101,
  ];
}
