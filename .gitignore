# Dependencies managed by Composer.
/recipes
/vendor
/public_html/core
/public_html/libraries
/public_html/modules/contrib
/public_html/profiles/contrib
/public_html/themes/contrib

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Site-specific settings and files.
/public_html/sites/*/settings*.php
/public_html/sites/*/services*.yml
/public_html/sites/*/files
/public_html/sites/*/private

# Test site directories generated by automated testing.
/public_html/sites/simpletest

# PHP scripts scaffolded into the web root by Drupal core.
/public_html/*.php

# Project-level authentication and authorization credentials for Composer.
# Per https://getcomposer.org/doc/articles/authentication-for-private-packages.md#authentication-in-auth-json-per-project,
# this should never be under version control.
/auth.json

/.vscode
/.ddev